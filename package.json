{
  "name": "jobut",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "prestart": "npm run verify:production-runtime",
    "start": "next start",
    "verify:production-runtime": "node scripts/verify-production-runtime.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:auth": "NODE_OPTIONS=--conditions=react-server tsx --test src/auth/auth.test.ts",
    "test:onboarding": "NODE_OPTIONS=--conditions=react-server tsx --test src/onboarding/validation.test.ts",
    "test:packages": "tsx --test src/packages/purchase-policy.test.ts",
    "test:payments": "NODE_OPTIONS=--conditions=react-server tsx --test src/payments/payment.test.ts",
    "test:sms": "NODE_OPTIONS=--conditions=react-server tsx --test src/auth/sms/melipayamak.test.ts",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:integration:verify-db": "node scripts/verify-integration-database.mjs",
    "test:integration:full": "node scripts/run-db-integration.mjs",
    "test:e2e": "playwright test",
    "test:e2e:verify-db": "node scripts/verify-e2e-database.mjs",
    "test:e2e:full": "node scripts/run-e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run test:unit && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed/industries.ts",
    "admin:bootstrap-owner": "tsx scripts/bootstrap-platform-owner.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@react-pdf/font": "^4.1.2",
    "@react-pdf/layout": "^5.2.0",
    "@react-pdf/primitives": "^4.4.0",
    "@react-pdf/render": "^4.7.0",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-orm": "0.45.3",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "pdfkit": "^0.20.1",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "sanitize-html": "2.18.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "vazirmatn": "^33.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "26.6.4",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
